---
import '@fontsource/noto-serif/vietnamese-400.css';
import '@fontsource/noto-serif/latin-400.css';
import '@fontsource/noto-serif/vietnamese-400-italic.css';
import '@fontsource/noto-serif/latin-400-italic.css';
import '@fontsource/be-vietnam-pro/vietnamese-400.css';
import '@fontsource/be-vietnam-pro/latin-400.css';
import '@fontsource/be-vietnam-pro/vietnamese-500.css';
import '@fontsource/be-vietnam-pro/latin-500.css';
import '../styles/global.css';
import '../styles/motion.css';
import Journey from '../components/Journey.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Story from '../components/Story.astro';
import Chapter from '../components/Chapter.astro';
import Gallery from '../components/Gallery.astro';
import Community from '../components/Community.astro';
import NextChapter from '../components/NextChapter.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/content';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialImage = Astro.site ? new URL('social.png', Astro.site).href : '/social.png';
const person = { '@context': 'https://schema.org', '@type': 'Person', ...site.person, ...(canonical ? { url: canonical } : {}), ...(site.facebookUrl ? { sameAs: [site.facebookUrl] } : {}) };
---
<!doctype html>
<html lang="vi"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#354638"/><title>{site.title}</title><meta name="description" content={site.description}/>{canonical && <link rel="canonical" href={canonical}/>}<meta property="og:type" content="website"/><meta property="og:locale" content="vi_VN"/><meta property="og:site_name" content="TTP Cosplay Offline"/><meta property="og:title" content={site.title}/><meta property="og:description" content={site.description}/>{canonical && <meta property="og:url" content={canonical}/>}<meta property="og:image" content={socialImage}/><meta property="og:image:alt" content="TTP Cosplay Offline — Một nơi để gặp nhau"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={site.title}/><meta name="twitter:description" content={site.description}/><meta name="twitter:image" content={socialImage}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')}/></head><body id="top"><a class="skip-link" href="#main">Đến nội dung chính</a><Header/><main id="main"><Hero/><About/><Story/><Chapter/><Gallery/><Community/><NextChapter/></main><Footer/><Journey/></body></html>
