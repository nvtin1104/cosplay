---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { chapter1 } from '../../data/content';
---
<SiteLayout title="Hành trình | TTP Cosplay Offline" description="Theo dõi hành trình TTP Cosplay Offline qua từng chapter. Chapter đầu tiên bắt đầu ngày 27.09.2026.">
  <section class="journey-page section-pad" aria-labelledby="journey-title">
    <p class="eyebrow">TTP COSPLAY OFFLINE / HÀNH TRÌNH</p>
    <h1 id="journey-title">Từng cuộc gặp,<br/><em>thành một câu chuyện.</em></h1>
    <p class="journey-intro">Mỗi chapter lưu lại một chặng của TTP Cosplay Offline. Hành trình hiện có chương đầu tiên.</p>
    <ol class="chapter-list">
      <li><a class="chapter-card" href="/journey/chapter-1/"><span class="chapter-card-index">01</span><div><p class="eyebrow">{chapter1.date}</p><h2>{chapter1.title}</h2><p>{chapter1.summary}</p><span class="chapter-card-link">Đọc chapter <span aria-hidden="true">↗</span></span></div></a></li>
    </ol>
    <a class="text-link" href="/">Về trang chủ <span aria-hidden="true">↗</span></a>
  </section>
</SiteLayout>
