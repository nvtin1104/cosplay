---
import { Image } from 'astro:assets';
import ChapterMosaic from './ChapterMosaic.astro';
import { chapter1 } from '../data/content';
import chapter1Chip from '../assets/chapter1/chip.png';
---
<div class="chapter-shell">
  <section id="chapter" class="chapter section-pad" aria-labelledby="chapter-title">
    <div class="chapter-heading"><div><p class="eyebrow">03 / CHAPTER 01</p><h2 id="chapter-title">{chapter1.title}<span class="chapter-date"><time datetime={chapter1.dateTime}>{chapter1.date}</time></span></h2></div><p>{chapter1.summary}</p></div>
    <ChapterMosaic/>
    <div class="chapter-foot"><span>FASHION SHOW / TRAO GIẢI / RANDOM DANCE / GIAO LƯU</span><p>Và đây mới chỉ là khởi đầu.</p></div>
    <nav class="chapter-actions" aria-label="Khám phá các chương"><a class="button" href="/journey/chapter-1/">Xem Chapter 1 <span aria-hidden="true">↗</span></a><a class="chapter-more" href="/journey/">Xem các chapter tiếp theo <span aria-hidden="true">→</span></a></nav>
  </section>
  <figure class="chapter-corner-photo"><Image src={chapter1Chip} alt="Cosplayer trong trang phục hầu gái giữa không gian ngoài trời tại Chapter 1" widths={[180, 260, 360, 520]} sizes="(max-width: 600px) 72px, 150px" loading="lazy"/></figure>
</div>
