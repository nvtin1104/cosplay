---
import Willow from './Willow.astro';
import Photo from './Photo.astro';
import { photos } from '../data/content';
const hero = photos.find(p => p.id === 'hero')!;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-topline"><span>COSPLAY · CONNECTION · MEMORIES</span><span>MỘT CÂU CHUYỆN CỦA P</span></div>
  <div class="hero-content">
    <div class="hero-copy"><p class="eyebrow">TỪ THẾ GIỚI CỦA CHÚNG TA, ĐẾN ĐỜI THẬT</p><h1 id="hero-title">TTP <span>Cosplay Offline</span></h1><p class="hero-tagline">Một nơi để<br/><em>gặp nhau.</em></p><p class="hero-description">Để những người từng xa lạ trở thành bạn bè.<br/>Để một bộ cosplay trở thành một kỷ niệm.</p><a class="text-link" href="#story">Khám phá câu chuyện <span aria-hidden="true">↗</span></a></div>
    {hero.src ? <Photo photo={hero} priority class="hero-image"/> : <div class="hero-art"><div class="sun-disc"></div><Willow variant="hero-art"/><span class="art-note">GỐC RỄ TỪ ĐAM MÊ.<br/>LỚN LÊN BẰNG KẾT NỐI.</span><span class="art-seal" aria-hidden="true">P</span></div>}
  </div>
  <div class="hero-bottom"><a href="#about"><span aria-hidden="true">↓</span> CUỘN ĐỂ KHÁM PHÁ</a><span>EST. 2026 <span class="small-divider">/</span> TTP COSPLAY OFFLINE</span></div>
</section>
