---
import { Image } from 'astro:assets';
import { heroPhotos } from '../data/content';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-topline"><span>COSPLAY · CONNECTION · MEMORIES</span><span>MỘT CÂU CHUYỆN CỦA Phát</span></div>
  <div class="hero-content">
    <div class="hero-copy"><p class="eyebrow">TỪ THẾ GIỚI CỦA CHÚNG TA, ĐẾN ĐỜI THẬT</p><h1 id="hero-title">TTP <span>Cosplay Offline</span></h1><p class="hero-tagline">Một nơi để<br/><em>gặp nhau.</em></p><p class="hero-description">Để những người từng xa lạ trở thành bạn bè.<br/>Để một bộ cosplay trở thành một kỷ niệm.</p><a class="text-link" href="#story">Khám phá câu chuyện <span aria-hidden="true">↗</span></a></div>
    <div class="hero-art" aria-label="Phát cùng cộng đồng cosplay TTP">
      <div class="sun-disc" aria-hidden="true"></div>
      <figure class="hero-photo hero-photo--dan1"><Image src={heroPhotos[0].src} alt={heroPhotos[0].alt} widths={[240, 360, 540, 720, 960]} sizes="(max-width: 600px) 46vw, 30vw" loading="eager" fetchpriority="high"/></figure>
      <figure class="hero-photo hero-photo--dan2"><Image src={heroPhotos[1].src} alt={heroPhotos[1].alt} widths={[240, 360, 540, 720, 960]} sizes="(max-width: 600px) 46vw, 30vw" loading="eager"/></figure>
      <figure class="hero-photo hero-photo--ttp"><img src="/home/ttp.png" alt="Trần Tiến Phát — người sáng lập TTP Cosplay Offline"/></figure>
      <span class="art-note">GỐC RỄ TỪ ĐAM MÊ.<br/>LỚN LÊN BẰNG KẾT NỐI.</span>
    </div>
  </div>
  <div class="hero-bottom"><a href="#about"><span aria-hidden="true">↓</span> CUỘN ĐỂ KHÁM PHÁ</a><span>EST. 2026 <span class="small-divider">/</span> TTP COSPLAY OFFLINE</span></div>
</section>
