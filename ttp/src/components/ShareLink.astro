---
import { productionSite, seoPages } from '../data/seo';
interface Props { path?: string; floating?: boolean; }
const { path = Astro.url.pathname, floating = false } = Astro.props;
const url = new URL(path, Astro.site || productionSite).href;
const title = seoPages.find(page => page.path === path)?.title || 'TTP Cosplay Offline';
---
<chapter-share class:list={['chapter-share', floating && 'chapter-share--floating']} data-url={url} data-title={title}>
  <a href={url}>Liên kết riêng ↗</a>
  <button type="button" hidden>Chia sẻ</button>
  <span role="status" aria-live="polite"></span>
  <input readonly value={url} aria-label="Liên kết để chia sẻ" hidden/>
</chapter-share>
<script>
  class ChapterShare extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button')!;
      const status = this.querySelector('[role="status"]')!;
      const input = this.querySelector('input')!;
      button.hidden = false;
      button.addEventListener('click', async () => {
        const url = this.dataset.url!;
        try {
          if (navigator.share) {
            await navigator.share({ title: this.dataset.title, url });
          } else {
            await navigator.clipboard.writeText(url);
            status.textContent = 'Đã sao chép liên kết';
          }
        } catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') return;
          input.hidden = false;
          input.focus();
          input.select();
          status.textContent = 'Sao chép liên kết bên dưới';
        }
      });
    }
  }
  if (!customElements.get('chapter-share')) customElements.define('chapter-share', ChapterShare);
</script>
<style>
  .chapter-share{display:flex;align-items:center;flex-wrap:wrap;gap:8px 16px;margin-top:14px;font:400 11px/1.6 var(--sans)}
  .chapter-share a{border-bottom:1px solid currentColor}
  .chapter-share button{font:inherit;cursor:pointer;color:inherit;background:transparent;border:1px solid currentColor;padding:7px 12px;border-radius:4px}
  .chapter-share button:focus-visible{outline:2px solid currentColor;outline-offset:3px}
  .chapter-share input{width:100%;font:inherit;padding:8px;color:var(--green);background:var(--cream);border:1px solid var(--line)}
  .chapter-share [hidden]{display:none}
  .chapter-share--floating{position:fixed;top:20px;right:20px;z-index:20;background:#18241bf0;color:var(--cream);padding:10px 14px;margin:0;max-width:calc(100vw - 150px);border:1px solid #ffffff33;border-radius:6px}
  @media(max-width:600px){.chapter-share--floating{top:14px;right:14px;gap:6px 10px;font-size:10px}.chapter-share--floating>a{display:none}}
</style>
