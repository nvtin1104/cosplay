{
  "name": "honey-shop-api",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "wrangler deploy --dry-run",
    "lint": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply honey-shop-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply honey-shop-db --remote",
    "db:seed:local": "wrangler d1 execute honey-shop-db --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute honey-shop-db --remote --file=./seed.sql"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.4",
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.34.0"
  }
}
